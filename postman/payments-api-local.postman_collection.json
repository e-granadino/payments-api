{
  "info": {
    "_postman_id": "7d4f2f3e-9a63-4c0f-9e4f-payments-api-v1",
    "name": "Payments API - Local",
    "description": "Postman collection for the Payments API. Local development credentials are embedded as Basic Auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "payment-user",
        "type": "string"
      },
      {
        "key": "password",
        "value": "payment-password",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "customerId",
      "value": "CUS-001"
    },
    {
      "key": "from",
      "value": "2026-09-01T00:00:00Z"
    },
    {
      "key": "to",
      "value": "2026-09-23T23:59:59Z"
    }
  ],
  "item": [
    {
      "name": "Create Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"customerId\": \"{{customerId}}\",\n    \"amount\": 150.75,\n    \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments"
          ]
        },
        "description": "Creates a payment. Status is assigned by the API as PENDING and createdAt is generated by the server."
      },
      "response": []
    },
    {
      "name": "Get Payments",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments?from={{from}}&to={{to}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        },
        "description": "Returns payments within the required date range."
      },
      "response": []
    },
    {
      "name": "Get Payments By Customer",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments?customerId={{customerId}}&from={{from}}&to={{to}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments"
          ],
          "query": [
            {
              "key": "customerId",
              "value": "{{customerId}}"
            },
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        },
        "description": "Returns payments for a customer within the required date range."
      },
      "response": []
    },
    {
      "name": "Swagger OpenAPI",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v3/api-docs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v3",
            "api-docs"
          ]
        },
        "description": "OpenAPI document. This endpoint is normally public."
      },
      "response": []
    }
  ]
}